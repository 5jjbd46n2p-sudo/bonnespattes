# Chaîne de connexion à ta base Neon (Postgres). Exemple :
# postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
# (région européenne conseillée pour le RGPD : eu-central-1 Francfort)
DATABASE_URL=

# Clé secrète pour signer les sessions de connexion. OBLIGATOIRE : sans elle,
# personne ne peut se connecter (aucune valeur par défaut n'est utilisée, pour
# des raisons de sécurité). Génère une longue chaîne aléatoire, par exemple
# avec `openssl rand -hex 32`, et ne la partage jamais.
JWT_SECRET=

# Généré automatiquement par Vercel quand tu connectes un "Blob store" au projet
# (Storage > Create Database > Blob). Pas besoin de le remplir en local si tu ne
# testes pas l'upload de photos.
BLOB_READ_WRITE_TOKEN=

# Envoi automatique par email des identifiants du portail client (à la création
# du client ou lors d'une réinitialisation de mot de passe).
# Crée un compte gratuit sur https://resend.com, récupère une clé API, et
# vérifie un domaine d'envoi (ou utilise l'adresse de test onboarding@resend.dev
# tant que tu n'as pas vérifié ton propre domaine).
RESEND_API_KEY=

# Adresse d'expédition des emails, ex. "Aux Bonnes Pattes <contact@tondomaine.fr>"
EMAIL_FROM=

# URL publique de ton application (ex. https://aux-bonnes-pattes.vercel.app),
# utilisée pour inclure un lien de connexion direct dans l'email des identifiants.
NEXT_PUBLIC_APP_URL=

# Secret de la tâche quotidienne de purge RGPD (/api/cron/retention). Vercel
# l'envoie automatiquement à la tâche planifiée (vercel.json). Génère-le avec
# `openssl rand -hex 32`. Sans lui, les durées de conservation ne sont pas appliquées.
CRON_SECRET=

# Sel servant à rendre les adresses IP non identifiables dans la base (limites
# anti-attaque, demandes de contact). Chaîne aléatoire, `openssl rand -hex 32`.
LEAD_IP_SALT=
